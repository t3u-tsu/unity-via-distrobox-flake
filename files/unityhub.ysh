#!/usr/bin/env ysh
# Launch Unity Hub in a Distrobox container, provisioning it on first use;
# forwards unityhub:// deep links to an already-running instance.

const CONTAINER_NAME = 'unity-via-distrobox'
# ysh does not bind env vars; fall back when unset or empty.
try {
  var xdgCfg = ENV.XDG_CONFIG_HOME
}
if failed {
  var xdgCfg = "$[ENV.HOME]/.config"
}
if (xdgCfg === '') {
  setvar xdgCfg = "$[ENV.HOME]/.config"
}
const INI_FILE = "$xdgCfg/unity-via-distrobox/distrobox.ini"
try {
  var xdgState = ENV.XDG_STATE_HOME
}
if failed {
  var xdgState = "$[ENV.HOME]/.local/state"
}
if (xdgState === '') {
  setvar xdgState = "$[ENV.HOME]/.local/state"
}
# Set by the wrapper from the stopOnExit option.
try {
  var stopOnExitEnv = ENV.UNITY_STOP_ON_EXIT
}
if failed {
  var stopOnExitEnv = ''
}
const STOP_ON_EXIT = (stopOnExitEnv === 'true')
const PROVISION_DIR = "$xdgState/unity-via-distrobox"
const PROVISION_LOG = "$PROVISION_DIR/provision.log"
const PROVISION_LOCK = "$PROVISION_DIR/provision.lock"
const STOPPED_MARKER = "$PROVISION_DIR/stopped"

proc notify (message) {
  if command -v notify-send >/dev/null 2>&1 {
    # D-Bus may be unreachable; drop errors and keep going.
    notify-send -i unityhub 'Unity Hub' $message 2>/dev/null || true
  }
}

proc provision (rebuild = '') {
  notify 'Setting up Unity container (first launch, may take a few minutes)...'
  echo 'Provisioning Unity Distrobox container...'
  echo 'This will download Ubuntu 22.04 and install Unity Hub.'
  mkdir -p $PROVISION_DIR
  # Serialize provisioning: a concurrent launcher run (desktop entry vs.
  # systemctl start) must not race distrobox assemble create.
  {
    flock 9
    # Remove inside the lock so concurrent abnormal-exit runs cannot
    # race distrobox rm with create.
    if (rebuild === 'true') {
      distrobox rm -f $CONTAINER_NAME
    }
    # Keep the full distrobox output on failure; remove it on success.
    try {
      distrobox assemble create --file $INI_FILE > $PROVISION_LOG 2>&1
      # assemble create only creates the container; initialization runs on the
      # first enter.
      distrobox enter $CONTAINER_NAME -- true >> $PROVISION_LOG 2>&1
    }
    if failed {
      echo "Container setup failed. Full log: $PROVISION_LOG"
      tail -n 30 $PROVISION_LOG
      notify "Unity container setup failed. See $PROVISION_LOG"
      exit 1
    }
    rm -f $PROVISION_LOG
    notify 'Unity container ready.'
    # Children (distrobox) inherit fd 9; unlock explicitly so later runs
    # do not misdetect provisioning as still in progress.
    flock -u 9
  } 9> $PROVISION_LOCK
}

func containerRow (lines, name) {
  for line in (lines) {
    var parts = split(line, '|')
    if (len(parts) >= 2 and parts[1].trim() === name) {
      return (line)
    }
  }
  return (null)
}

var lines = @(distrobox list)
var row = containerRow(lines, CONTAINER_NAME)

if (row === null) {
  echo 'Unity container not found. Starting automatic setup...'
  provision
} elif (row.find('Exited (0)') < 0 and row.find('Exited (') >= 0) {
  if test -e $STOPPED_MARKER {
    # Previous run stopped cleanly via stopOnExit; just restart.
    rm -f $STOPPED_MARKER
  } else {
    echo 'Unity container exited abnormally. Rebuilding...'
    notify 'Rebuilding Unity container (previous run exited abnormally)...'
    provision 'true'
  }
}

# Unity Hub sign-in opens URLs via xdg-open; re-point it at
# distrobox-host-exec so redirects reach the host browser.
podman exec -u root $CONTAINER_NAME sh -c '
  if [ -f /usr/bin/xdg-open ] && [ ! -L /usr/bin/xdg-open ]; then
    rm -f /usr/bin/xdg-open
    ln -sf /usr/bin/distrobox-host-exec /usr/bin/xdg-open
  fi
' || true

# Icon=unityhub only exists in the container; mirror it to the host.
try {
  var xdgData = ENV.XDG_DATA_HOME
}
if failed {
  var xdgData = "$[ENV.HOME]/.local/share"
}
if (xdgData === '') {
  setvar xdgData = "$[ENV.HOME]/.local/share"
}
var iconDir = "$xdgData/icons/hicolor/256x256/apps"
var iconPath = "$iconDir/unityhub.png"
if test ! -e $iconPath {
  mkdir -p $iconDir
  podman cp $CONTAINER_NAME:/usr/share/pixmaps/unityhub.png $iconPath || true
}

# A concurrent launcher run may find Unity Hub already up, or still being
# provisioned (flock held); treat both as running.
var hubUp = false
var provisioning = false
try {
  podman exec $CONTAINER_NAME pgrep -x unityhub-bin >/dev/null 2>&1
  setvar hubUp = true
}
if (not hubUp) {
  try {
    flock -n $PROVISION_LOCK -c 'true' >/dev/null 2>&1
  }
  if failed {
    setvar hubUp = true
    setvar provisioning = true
  }
}

if (hubUp) {
  if (provisioning) {
    echo 'Unity Hub is already being set up.'
    exit 0
  }
  if (len(ARGV) === 0) {
    echo 'Unity Hub is already running.'
    exit 0
  }
} else {
  # notify 'Launching Unity Hub...'
  true
}

# Drop host GIO/SSL env vars; the container uses native Ubuntu libs.
try {
  env \
    -u GIO_EXTRA_MODULES \
    -u SSL_CERT_FILE \
    -u NIX_SSL_CERT_FILE \
    -u CURL_CA_BUNDLE \
    -u SSL_CERT_DIR \
    -u NIX_SSL_CERT_DIR \
    distrobox enter -T $CONTAINER_NAME -- unityhub "$@"
}
var hubStatus = _status

# stopOnExit: stop the container only when this run actually launched Unity
# Hub (deep links and already-running runs return without starting it).
if (STOP_ON_EXIT and hubStatus === 0 and not hubUp) {
  try {
    podman exec $CONTAINER_NAME pgrep -x unityhub-bin >/dev/null 2>&1
  }
  if failed {
    # Mark the stop as intentional so the next launch does not rebuild.
    touch $STOPPED_MARKER
    podman stop $CONTAINER_NAME
  }
}

exit $hubStatus
