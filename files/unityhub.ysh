#!/usr/bin/env ysh
# Launch Unity Hub inside a Distrobox container, provisioning it on first
# use. Runs as ExecStart of unity-via-distrobox.service or directly from the
# desktop entry (systemd-run) with a unityhub:// deep-link URL as $1.

const CONTAINER_NAME = 'unity-via-distrobox'
# Oils does not bind env vars as shell vars, so read ENV directly and fall
# back to $HOME/.config when XDG_CONFIG_HOME is unset.
try {
  var xdgCfg = ENV.XDG_CONFIG_HOME
}
if failed {
  var xdgCfg = "$[ENV.HOME]/.config"
}
if (xdgCfg === '') {
  setvar xdgCfg = "$[ENV.HOME]/.config"
}
const INI_FILE = "$xdgCfg/distrobox/distrobox.ini"
# Logs belong under XDG_STATE_HOME; empty counts as unset, so both fall
# back to $HOME/.local/state.
try {
  var xdgState = ENV.XDG_STATE_HOME
}
if failed {
  var xdgState = "$[ENV.HOME]/.local/state"
}
if (xdgState === '') {
  setvar xdgState = "$[ENV.HOME]/.local/state"
}
# stopOnExit: stop the container when Unity Hub exits. Set by the
# wrapper environment (home-manager option); default to false.
try {
  var stopOnExitEnv = ENV.UNITY_STOP_ON_EXIT
}
if failed {
  var stopOnExitEnv = ''
}
const STOP_ON_EXIT = (stopOnExitEnv === 'true')
const PROVISION_DIR = "$xdgState/unity-via-distrobox"
const PROVISION_LOG = "$PROVISION_DIR/provision.log"

proc notify (message) {
  if command -v notify-send >/dev/null 2>&1 {
    # D-Bus may be unreachable; drop errors and keep going.
    notify-send -i unityhub 'Unity Hub' $message 2>/dev/null || true
  }
}

proc provision () {
  notify 'Setting up Unity container (first launch, may take a few minutes)...'
  echo 'Provisioning Unity Distrobox container...'
  echo 'This will download Ubuntu 22.04 and install Unity Hub.'
  # Keep the full distrobox output on failure; remove it on success.
  mkdir -p $PROVISION_DIR
  try {
    distrobox assemble create --file $INI_FILE > $PROVISION_LOG 2>&1
  }
  if failed {
    echo "Container setup failed. Full log: $PROVISION_LOG"
    tail -n 30 $PROVISION_LOG
    notify "Unity container setup failed. See $PROVISION_LOG"
    exit 1
  }
  rm -f $PROVISION_LOG
  notify 'Unity container ready.'
}

# Return the `distrobox list` row whose NAME field (after '|') is `name`.
func containerRow (lines, name) {
  for line in (lines) {
    var parts = split(line, '|')
    if (len(parts) >= 2 and parts[1].trim() === name) {
      return (line)
    }
  }
  return (null)
}

var lines = @(distrobox list)
var row = containerRow(lines, CONTAINER_NAME)

if (row === null) {
  echo 'Unity container not found. Starting automatic setup...'
  provision
} elif (row.find('Exited (0)') < 0 and row.find('Exited (') >= 0) {
  echo 'Unity container exited abnormally. Rebuilding...'
  notify 'Rebuilding Unity container (previous run exited abnormally)...'
  distrobox rm -f $CONTAINER_NAME
  provision
}

# Unity Hub sign-in opens URLs via xdg-open; re-point it at
# distrobox-host-exec so redirects reach the host browser.
podman exec -u root $CONTAINER_NAME sh -c '
  if [ -f /usr/bin/xdg-open ] && [ ! -L /usr/bin/xdg-open ]; then
    rm -f /usr/bin/xdg-open
    ln -sf /usr/bin/distrobox-host-exec /usr/bin/xdg-open
  fi
' || true

# Icon=unityhub only exists in the container; mirror it to the host.
var iconDir = "$[ENV.HOME]/.local/share/icons/hicolor/256x256/apps"
var iconPath = "$iconDir/unityhub.png"
if test ! -e $iconPath {
  mkdir -p $iconDir
  podman cp $CONTAINER_NAME:/usr/share/pixmaps/unityhub.png $iconPath || true
}

# Only announce a fresh launch: browser deep links re-enter this
# launcher while Unity Hub is already running and must stay silent.
# Check the container process directly: the desktop entry runs us via a
# transient systemd-run unit, so the named unit is not necessarily
# active while Unity Hub is up.
try {
  podman exec $CONTAINER_NAME pgrep -x unityhub-bin >/dev/null 2>&1
}
if failed {
  notify 'Launching Unity Hub...'
}

# Drop host GIO/SSL env vars; the container uses native Ubuntu libs.
try {
  env \
    -u GIO_EXTRA_MODULES \
    -u SSL_CERT_FILE \
    -u NIX_SSL_CERT_FILE \
    -u CURL_CA_BUNDLE \
    -u SSL_CERT_DIR \
    -u NIX_SSL_CERT_DIR \
    distrobox enter -T $CONTAINER_NAME -- unityhub "$@"
}
var hubStatus = _status

# With stopOnExit, stop the container once Unity Hub is gone. A deep
# link returns as soon as the URL is handed to the already-running
# instance, so only stop when no unityhub-bin process remains.
if (STOP_ON_EXIT) {
  try {
    podman exec $CONTAINER_NAME pgrep -x unityhub-bin >/dev/null 2>&1
  }
  if failed {
    podman stop $CONTAINER_NAME
  }
}

exit $hubStatus
