#!/usr/bin/env ysh
# Merge minimizeToTray (ARGV[0]) into Unity Hub's user-settings.json.
# Runs from home.activation.

# ysh does not bind env vars; fall back when unset or empty.
try {
  var xdgCfg = ENV.XDG_CONFIG_HOME
}
if failed {
  var xdgCfg = "$[ENV.HOME]/.config"
}
if (xdgCfg === '') {
  setvar xdgCfg = "$[ENV.HOME]/.config"
}
const SETTINGS = "$xdgCfg/unityhub/user-settings.json"

var settings = ({})

if test -f $SETTINGS {
  # On failure (empty/broken JSON) the setvar is skipped, leaving {}.
  try {
    json read < $SETTINGS
    setvar settings = _reply
  }
}

setvar settings.minimizeToTray = (ARGV[0] === "true")

mkdir -p "$xdgCfg/unityhub"
json write (settings) > $SETTINGS
